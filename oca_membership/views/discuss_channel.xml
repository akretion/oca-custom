<odoo>

    <!-- discuss.channel Search -->
    <record id="mail.discuss_channel_view_search" model="ir.ui.view">
        <field name="name">discuss.channel.search.oca_membership</field>
        <field name="model">discuss.channel</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter string="Work Group" name="is_membership_work_group" domain="[('is_membership_work_group', '=', True)]" />
                <separator />
            </filter>
        </field>
    </record>

    <!-- discuss.channel Form -->
    <record id="discuss_channel_view_form" model="ir.ui.view">
        <field name="name">discuss.channel.form.oca_membership</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />

        <field name="arch" type="xml">
            <page name="privacy" position="inside">
                <field name="is_membership_work_group" widget="boolean_toggle" />
            </page>
        </field>
    </record>

    <!-- New entry menu 'Work Groups' in Membership app -->
    <record model="ir.actions.act_window" id="action_membership_work_group">
        <field name="name">Work Groups</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            "search_default_is_membership_work_group": 1,
            "default_is_membership_work_group": 1,
        }</field>
    </record>
    <menuitem
        id="menu_membership_work_group"
        sequence="30"
        parent="membership.menu_association"
        action="action_membership_work_group"
    />
    
</odoo>
